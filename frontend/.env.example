# SourceLens uses same-origin Vercel API Functions by default.
# Leave blank (or unset) on Vercel. Do not point this at the old Render server.
VITE_API_BASE_URL=

# VITE_* values are PUBLIC in browser JavaScript. Never place model API keys here.
# For optional generated answers, add GEMINI_API_KEY or GROQ_API_KEY and
# RAG_GENERATION_PROVIDER in Vercel's SERVER-SIDE project environment variables.
